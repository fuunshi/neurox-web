# The build context is uploaded to the daemon before the first instruction runs,
# so everything here is bytes that would be sent and then ignored. Without this
# file a context including node_modules and .next is hundreds of megabytes.

node_modules
.next
out
build

# The image is built from the lockfile, never from a checkout's local env.
.env
.env.*
!.env.example

.git
.gitignore
.vercel
*.log
npm-debug.log*
.DS_Store
