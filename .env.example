# Copy to .env.local and adjust.

# Base URL of the NestJS API.
#
# No trailing slash, and no `/api` suffix: the API has no global prefix, so its
# routes sit at the root (`/auth/login`, `/decks`). Only its Swagger UI lives
# under /api/docs.
#
# Only the server reads this — the browser never talks to the API directly, it
# goes through this app's route handlers. That is why it is not NEXT_PUBLIC_*.
BACKEND_BASE_URL=http://localhost:3232

# Adds the Secure flag to the session cookies. Must be "true" in production and
# must be "false" locally: a Secure cookie is silently dropped over plain HTTP,
# which would break every login attempt in development.
SESSION_COOKIE_SECURE=false
